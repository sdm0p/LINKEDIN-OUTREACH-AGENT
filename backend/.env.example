# Copy to backend/.env and fill in.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# Default model is gemini-3.1-flash-lite. Rate limits are per model, so
# switching models is also the quickest way onto a fresh free-tier quota.
# GEMINI_MODEL=gemini-3.1-flash-lite
# MAX_DRAFTS_PER_DAY=20
