# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Free key: https://aistudio.google.com/apikey
# (You can also set the key from the app's Settings page — it is
#  verified with a live call before storing, and survives restarts
#  in the data directory.)

GEMINI_API_KEY=AIza...

# Optional. Any Gemini-API model id; rate limits are per model, so
# switching models is the quickest way onto a fresh free-tier quota.
# Gemma models work too (JSON mode is auto-disabled for them).
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional. Daily cap on outreach drafts (cost control).
MAX_DRAFTS_PER_DAY=20
